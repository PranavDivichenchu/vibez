{
  "name": "vibez",
  "private": true,
  "version": "0.0.0",
  "description": "An IDE where your codebase is a node graph built from what actually ran",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "node --test 'packages/*/test/*.test.ts'",
    "demo": "node packages/core/src/demo.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/capture",
    "trace": "node scripts/trace.ts",
    "view": "node scripts/view.ts",
    "fork:setup": "node scripts/fork-setup.ts",
    "fork:diff": "node scripts/fork-diff.ts",
    "fork:run": "node scripts/fork-run.ts",
    "sync:core": "node scripts/sync-core.ts",
    "fork:build": "node fork/apply.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}