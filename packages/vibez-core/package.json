{
  "name": "vibez-core",
  "displayName": "Vibez",
  "description": "Your codebase as a node graph built from what actually ran",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "vscode": "^1.90.0" },
  "main": "./src/extension.ts",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vibez.graph",
        "displayName": "Vibez graph",
        "selector": [{ "filenamePattern": "*.flow" }],
        "priority": "default"
      }
    ],
    "commands": [
      { "command": "vibez.openGraph", "title": "Vibez: Open the graph", "icon": "$(circuit-board)" },
      { "command": "vibez.record", "title": "Vibez: Record a flow" }
    ],
    "configuration": {
      "title": "Vibez",
      "properties": {
        "vibez.otlpPort": { "type": "number", "default": 4318, "description": "Port the trace receiver listens on." },
        "vibez.mode": { "type": "string", "enum": ["rough", "measured"], "default": "rough",
          "description": "Dev-server timings are relative only; 'measured' is for production builds." }
      }
    }
  }
}
